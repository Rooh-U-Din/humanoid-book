# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Qdrant Vector Database Configuration
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# Neon Serverless Postgres Configuration
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/dbname?sslmode=require

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Vercel Configuration (Optional - defaults to Render production backend)
DOCUSAURUS_BACKEND_URL=https://backend-book-vtha.onrender.com
# SITE_URL=https://your-custom-domain.com

